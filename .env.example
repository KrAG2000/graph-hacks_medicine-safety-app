# FalkorDB - or set FALKORDB_URL=falkor://user:pass@host:port for FalkorDB Cloud
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6381
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_URL=
FALKORDB_GRAPH=meds

# LLM: openai | anthropic | offline (auto-detected from whichever key is set; offline needs no key)
# LLM_PROVIDER=
# LLM_MODEL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   (any OpenAI-compatible endpoint works)
ANTHROPIC_API_KEY=

# API server (npm run server) and CLI client (npm start)
PORT=8787
# MSG_API_URL=http://127.0.0.1:8787
# JWT signing secrets: 32+ random characters each, different from each other. Generate with:
#   openssl rand -hex 32
# Without them the server uses random per-process secrets, so everyone is logged out on restart.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=900        # seconds (15 min)
# JWT_REFRESH_TTL=604800    # seconds (7 days)
