{
  "name": "med-safety-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Medication safety checker for family caregivers: agents over a FalkorDB drug graph with clinician sign-off",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "cli": "node --env-file-if-exists=.env src/cli.js",
    "seed": "node --env-file-if-exists=.env src/seed.js --reset",
    "demo": "node --env-file-if-exists=.env src/demo.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "lint": "eslint src test public",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "falkordb": "^6.2.0"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "globals": "^15.11.0"
  }
}
