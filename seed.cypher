CREATE (:Drug {id:'drug-amoxil', name:'Amoxicillin', brand:'Amoxil'})
CREATE (:Drug {id:'drug-biaxin', name:'Clarithromycin', brand:'Biaxin'})
CREATE (:Drug {id:'drug-zithromax', name:'Azithromycin', brand:'Zithromax'})
