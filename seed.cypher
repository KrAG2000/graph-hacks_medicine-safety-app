CREATE (:Drug {id:'drug-mucinex', name:'Guaifenesin', brand:'Mucinex'})

// Drug -> ingredient
MATCH (d:Drug {id:'drug-warfarin'}), (i:Ingredient {id:'ing-warfarin'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-metformin'}), (i:Ingredient {id:'ing-metformin'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-lisinopril'}), (i:Ingredient {id:'ing-lisinopril'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-atorvastatin'}), (i:Ingredient {id:'ing-atorvastatin'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-tylenol'}), (i:Ingredient {id:'ing-acetaminophen'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-amlodipine'}), (i:Ingredient {id:'ing-amlodipine'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-aspirin'}), (i:Ingredient {id:'ing-aspirin'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-aleve'}), (i:Ingredient {id:'ing-naproxen'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-advil'}), (i:Ingredient {id:'ing-ibuprofen'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-amoxil'}), (i:Ingredient {id:'ing-amoxicillin'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-biaxin'}), (i:Ingredient {id:'ing-clarithromycin'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-zithromax'}), (i:Ingredient {id:'ing-azithromycin'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-nyquil'}), (i:Ingredient {id:'ing-acetaminophen'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-nyquil'}), (i:Ingredient {id:'ing-dextromethorphan'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-nyquil'}), (i:Ingredient {id:'ing-doxylamine'}) CREATE (d)-[:CONTAINS]->(i)
MATCH (d:Drug {id:'drug-mucinex'}), (i:Ingredient {id:'ing-guaifenesin'}) CREATE (d)-[:CONTAINS]->(i)

// Ingredient -> class
MATCH (i:Ingredient {id:'ing-warfarin'}), (c:DrugClass {id:'cls-anticoag'}) CREATE (i)-[:IN_CLASS]->(c)
MATCH (i:Ingredient {id:'ing-metformin'}), (c:DrugClass {id:'cls-biguanide'}) CREATE (i)-[:IN_CLASS]->(c)
MATCH (i:Ingredient {id:'ing-lisinopril'}), (c:DrugClass {id:'cls-ace'}) CREATE (i)-[:IN_CLASS]->(c)
MATCH (i:Ingredient {id:'ing-atorvastatin'}), (c:DrugClass {id:'cls-statin'}) CREATE (i)-[:IN_CLASS]->(c)
MATCH (i:Ingredient {id:'ing-amlodipine'}), (c:DrugClass {id:'cls-ccb'}) CREATE (i)-[:IN_CLASS]->(c)
MATCH (i:Ingredient {id:'ing-aspirin'}), (c:DrugClass {id:'cls-antiplatelet'}) CREATE (i)-[:IN_CLASS]->(c)
MATCH (i:Ingredient {id:'ing-naproxen'}), (c:DrugClass {id:'cls-nsaid'}) CREATE (i)-[:IN_CLASS]->(c)
MATCH (i:Ingredient {id:'ing-ibuprofen'}), (c:DrugClass {id:'cls-nsaid'}) CREATE (i)-[:IN_CLASS]->(c)
MATCH (i:Ingredient {id:'ing-amoxicillin'}), (c:DrugClass {id:'cls-pen'}) CREATE (i)-[:IN_CLASS]->(c)
MATCH (i:Ingredient {id:'ing-clarithromycin'}), (c:DrugClass {id:'cls-macrolide'}) CREATE (i)-[:IN_CLASS]->(c)
MATCH (i:Ingredient {id:'ing-azithromycin'}), (c:DrugClass {id:'cls-macrolide'}) CREATE (i)-[:IN_CLASS]->(c)
MATCH (i:Ingredient {id:'ing-doxylamine'}), (c:DrugClass {id:'cls-antihist1'}) CREATE (i)-[:IN_CLASS]->(c)

// What each drug is used for (drives "safer alternatives")
MATCH (d:Drug {id:'drug-tylenol'}), (n:Indication {id:'ind-pain'}) CREATE (d)-[:TREATS]->(n)
MATCH (d:Drug {id:'drug-advil'}), (n:Indication {id:'ind-pain'}) CREATE (d)-[:TREATS]->(n)
MATCH (d:Drug {id:'drug-aleve'}), (n:Indication {id:'ind-pain'}) CREATE (d)-[:TREATS]->(n)
MATCH (d:Drug {id:'drug-amoxil'}), (n:Indication {id:'ind-infection'}) CREATE (d)-[:TREATS]->(n)
MATCH (d:Drug {id:'drug-biaxin'}), (n:Indication {id:'ind-infection'}) CREATE (d)-[:TREATS]->(n)
MATCH (d:Drug {id:'drug-zithromax'}), (n:Indication {id:'ind-infection'}) CREATE (d)-[:TREATS]->(n)
MATCH (d:Drug {id:'drug-nyquil'}), (n:Indication {id:'ind-cold'}) CREATE (d)-[:TREATS]->(n)
MATCH (d:Drug {id:'drug-mucinex'}), (n:Indication {id:'ind-cold'}) CREATE (d)-[:TREATS]->(n)

// Interactions (stored once, matched in both directions). Can link ingredients or classes.
MATCH (a:DrugClass {id:'cls-nsaid'}), (b:DrugClass {id:'cls-anticoag'}) CREATE (a)-[:INTERACTS_WITH {severity:'major', effect:'An NSAID taken with a blood thinner sharply raises the risk of serious bleeding, including stomach bleeding.', source:'illustrative'}]->(b)
MATCH (a:DrugClass {id:'cls-nsaid'}), (b:DrugClass {id:'cls-ace'}) CREATE (a)-[:INTERACTS_WITH {severity:'moderate', effect:'NSAIDs can weaken blood-pressure control and, together with ACE inhibitors, raise the risk of kidney injury.', source:'illustrative'}]->(b)
MATCH (a:DrugClass {id:'cls-nsaid'}), (b:DrugClass {id:'cls-antiplatelet'}) CREATE (a)-[:INTERACTS_WITH {severity:'moderate', effect:'Raises stomach-bleeding risk, and some NSAIDs can block the heart-protective effect of low-dose aspirin.', source:'illustrative'}]->(b)
MATCH (a:Ingredient {id:'ing-clarithromycin'}), (b:Ingredient {id:'ing-atorvastatin'}) CREATE (a)-[:INTERACTS_WITH {severity:'major', effect:'Clarithromycin raises atorvastatin levels, increasing the risk of serious muscle damage (rhabdomyolysis).', source:'illustrative'}]->(b)
MATCH (a:Ingredient {id:'ing-clarithromycin'}), (b:DrugClass {id:'cls-anticoag'}) CREATE (a)-[:INTERACTS_WITH {severity:'moderate', effect:'Can raise INR and bleeding risk; INR usually needs closer monitoring.', source:'illustrative'}]->(b)
MATCH (a:Ingredient {id:'ing-clarithromycin'}), (b:Ingredient {id:'ing-amlodipine'}) CREATE (a)-[:INTERACTS_WITH {severity:'moderate', effect:'Can raise amlodipine levels, causing low blood pressure or swelling.', source:'illustrative'}]->(b)
MATCH (a:Ingredient {id:'ing-azithromycin'}), (b:DrugClass {id:'cls-anticoag'}) CREATE (a)-[:INTERACTS_WITH {severity:'minor', effect:'Occasional reports of raised INR; the care team may check INR more often.', source:'illustrative'}]->(b)

// Condition and age cautions
MATCH (a:DrugClass {id:'cls-nsaid'}), (c:Condition {id:'cond-ckd'}) CREATE (a)-[:CONTRAINDICATED_IN {severity:'major', reason:'NSAIDs can reduce blood flow to the kidneys and worsen kidney disease.'}]->(c)
MATCH (a:DrugClass {id:'cls-nsaid'}), (c:Condition {id:'cond-ulcer'}) CREATE (a)-[:CONTRAINDICATED_IN {severity:'major', reason:'NSAIDs can cause stomach bleeding and make ulcers worse.'}]->(c)
MATCH (a:DrugClass {id:'cls-nsaid'}), (c:Condition {id:'cond-hf'}) CREATE (a)-[:CONTRAINDICATED_IN {severity:'moderate', reason:'NSAIDs can make the body hold on to salt and water, which can worsen heart failure.'}]->(c)
MATCH (a:DrugClass {id:'cls-nsaid'}), (c:Condition {id:'cond-asthma'}) CREATE (a)-[:CONTRAINDICATED_IN {severity:'moderate', reason:'In some people with asthma, NSAIDs can trigger breathing problems.'}]->(c)
MATCH (a:Ingredient {id:'ing-acetaminophen'}), (c:Condition {id:'cond-liver'}) CREATE (a)-[:CONTRAINDICATED_IN {severity:'moderate', reason:'With liver disease the safe daily amount of acetaminophen is lower; ask for a personal limit.'}]->(c)
MATCH (a:DrugClass {id:'cls-antihist1'}), (g:AgeGroup {id:'ag-65'}) CREATE (a)-[:CAUTION_IN {severity:'moderate', reason:'Can cause confusion, drowsiness, constipation and falls in older adults (AGS Beers Criteria).'}]->(g)

// Kamala: conditions, allergy, medicines
MATCH (p:Patient {id:'pt-kamala'}), (c:Condition {id:'cond-afib'}) CREATE (p)-[:HAS_CONDITION]->(c)
MATCH (p:Patient {id:'pt-kamala'}), (c:Condition {id:'cond-t2d'}) CREATE (p)-[:HAS_CONDITION]->(c)
MATCH (p:Patient {id:'pt-kamala'}), (c:Condition {id:'cond-htn'}) CREATE (p)-[:HAS_CONDITION]->(c)
MATCH (p:Patient {id:'pt-kamala'}), (c:Condition {id:'cond-ckd'}) CREATE (p)-[:HAS_CONDITION]->(c)
MATCH (p:Patient {id:'pt-kamala'}), (c:DrugClass {id:'cls-pen'}) CREATE (p)-[:ALLERGIC_TO {reaction:'hives'}]->(c)
MATCH (p:Patient {id:'pt-kamala'}), (d:Drug {id:'drug-warfarin'}), (doc:Clinician {id:'cl-ortiz'}) CREATE (p)-[:HAS_RX]->(rx:Rx {id:'rx-k1', dose:'5 mg daily', since:'2024-03-10', active:true, otc:false})-[:OF]->(d), (doc)-[:PRESCRIBED]->(rx)
MATCH (p:Patient {id:'pt-kamala'}), (d:Drug {id:'drug-metformin'}), (doc:Clinician {id:'cl-rao'}) CREATE (p)-[:HAS_RX]->(rx:Rx {id:'rx-k2', dose:'500 mg twice daily', since:'2021-06-01', active:true, otc:false})-[:OF]->(d), (doc)-[:PRESCRIBED]->(rx)
MATCH (p:Patient {id:'pt-kamala'}), (d:Drug {id:'drug-lisinopril'}), (doc:Clinician {id:'cl-rao'}) CREATE (p)-[:HAS_RX]->(rx:Rx {id:'rx-k3', dose:'10 mg daily', since:'2020-01-15', active:true, otc:false})-[:OF]->(d), (doc)-[:PRESCRIBED]->(rx)
MATCH (p:Patient {id:'pt-kamala'}), (d:Drug {id:'drug-atorvastatin'}), (doc:Clinician {id:'cl-ortiz'}) CREATE (p)-[:HAS_RX]->(rx:Rx {id:'rx-k4', dose:'20 mg nightly', since:'2024-03-10', active:true, otc:false})-[:OF]->(d), (doc)-[:PRESCRIBED]->(rx)
MATCH (p:Patient {id:'pt-kamala'}), (d:Drug {id:'drug-tylenol'}) CREATE (p)-[:HAS_RX]->(:Rx {id:'rx-k5', dose:'500 mg as needed', since:'2025-11-02', active:true, otc:true})-[:OF]->(d)

// Ravi: conditions, medicines
