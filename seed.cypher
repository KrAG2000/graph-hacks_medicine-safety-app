CREATE (:Ingredient {id:'ing-doxylamine', name:'doxylamine'})
CREATE (:Ingredient {id:'ing-guaifenesin', name:'guaifenesin'})

// Drug products
CREATE (:Drug {id:'drug-warfarin', name:'Warfarin', brand:'Coumadin'})
CREATE (:Drug {id:'drug-metformin', name:'Metformin', brand:'Glucophage'})
CREATE (:Drug {id:'drug-lisinopril', name:'Lisinopril', brand:'Zestril'})
CREATE (:Drug {id:'drug-atorvastatin', name:'Atorvastatin', brand:'Lipitor'})
CREATE (:Drug {id:'drug-tylenol', name:'Acetaminophen', brand:'Tylenol'})
CREATE (:Drug {id:'drug-amlodipine', name:'Amlodipine', brand:'Norvasc'})
CREATE (:Drug {id:'drug-aspirin', name:'Aspirin', brand:'Bayer Low Dose'})
CREATE (:Drug {id:'drug-aleve', name:'Naproxen', brand:'Aleve'})
CREATE (:Drug {id:'drug-advil', name:'Ibuprofen', brand:'Advil'})
CREATE (:Drug {id:'drug-amoxil', name:'Amoxicillin', brand:'Amoxil'})
CREATE (:Drug {id:'drug-biaxin', name:'Clarithromycin', brand:'Biaxin'})
CREATE (:Drug {id:'drug-zithromax', name:'Azithromycin', brand:'Zithromax'})
