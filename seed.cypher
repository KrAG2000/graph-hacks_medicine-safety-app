CREATE (:Indication {id:'ind-pain', name:'Pain or fever'})
CREATE (:Indication {id:'ind-infection', name:'Bacterial infection'})
CREATE (:Indication {id:'ind-cold', name:'Cold symptoms'})

// Drug classes (dup_check: taking two drugs from this class is itself a warning)
CREATE (:DrugClass {id:'cls-anticoag', name:'Anticoagulants (blood thinners)', dup_check:true})
CREATE (:DrugClass {id:'cls-nsaid', name:'NSAIDs', dup_check:true})
