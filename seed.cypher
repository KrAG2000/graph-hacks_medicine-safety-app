// Earlier history: a past check on clarithromycin, which Dr. Rao decided against
CREATE (:Session {id:'sess-seed', started:'2026-09-02T10:00:00Z'})
MATCH (s:Session {id:'sess-seed'}), (u:Caregiver {id:'cg-priya'}) CREATE (s)-[:BY]->(u)
MATCH (s:Session {id:'sess-seed'}), (p:Patient {id:'pt-kamala'}) CREATE (s)-[:ABOUT]->(p)
CREATE (:Action {id:'act-seed1', agent:'checker', kind:'check', level:'stop', status:'rejected', ts:'2026-09-02T10:05:00Z', summary:'Kamala Iyer + Biaxin (Clarithromycin): STOP. Interacts with atorvastatin (muscle damage) and warfarin (INR).'})
MATCH (a:Action {id:'act-seed1'}), (s:Session {id:'sess-seed'}) CREATE (a)-[:IN_SESSION]->(s)
MATCH (a:Action {id:'act-seed1'}), (p:Patient {id:'pt-kamala'}) CREATE (a)-[:FOR_PATIENT]->(p)
MATCH (a:Action {id:'act-seed1'}), (d:Drug {id:'drug-biaxin'}) CREATE (a)-[:ON_DRUG]->(d)
MATCH (c:Clinician {id:'cl-rao'}), (a:Action {id:'act-seed1'}) CREATE (c)-[:REVIEWED {decision:'rejected', note:'Not starting clarithromycin. Prescribed azithromycin for the sinus infection instead.', ts:'2026-09-02T15:30:00Z'}]->(a)
