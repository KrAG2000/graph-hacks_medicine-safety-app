// Conditions, age groups, indications
CREATE (:Condition {id:'cond-afib', name:'Atrial fibrillation'})
CREATE (:Condition {id:'cond-t2d', name:'Type 2 diabetes'})
CREATE (:Condition {id:'cond-htn', name:'High blood pressure'})
CREATE (:Condition {id:'cond-ckd', name:'Chronic kidney disease'})
CREATE (:Condition {id:'cond-oa', name:'Osteoarthritis'})
CREATE (:AgeGroup {id:'ag-65', name:'Older adults (65+)', min_age:65})
CREATE (:Indication {id:'ind-pain', name:'Pain or fever'})
CREATE (:Indication {id:'ind-infection', name:'Bacterial infection'})
CREATE (:Indication {id:'ind-cold', name:'Cold symptoms'})

// Drug classes (dup_check: taking two drugs from this class is itself a warning)
CREATE (:DrugClass {id:'cls-anticoag', name:'Anticoagulants (blood thinners)', dup_check:true})
CREATE (:DrugClass {id:'cls-nsaid', name:'NSAIDs', dup_check:true})
CREATE (:DrugClass {id:'cls-ace', name:'ACE inhibitors', dup_check:true})
CREATE (:DrugClass {id:'cls-statin', name:'Statins', dup_check:true})
CREATE (:DrugClass {id:'cls-antiplatelet', name:'Antiplatelets', dup_check:false})
CREATE (:DrugClass {id:'cls-pen', name:'Penicillins', dup_check:false})
CREATE (:DrugClass {id:'cls-macrolide', name:'Macrolide antibiotics', dup_check:false})
CREATE (:DrugClass {id:'cls-antihist1', name:'First-generation antihistamines', dup_check:false})
CREATE (:DrugClass {id:'cls-biguanide', name:'Biguanides', dup_check:true})
CREATE (:DrugClass {id:'cls-ccb', name:'Calcium channel blockers', dup_check:true})

// Ingredients
CREATE (:Ingredient {id:'ing-warfarin', name:'warfarin'})
CREATE (:Ingredient {id:'ing-metformin', name:'metformin'})
CREATE (:Ingredient {id:'ing-lisinopril', name:'lisinopril'})
CREATE (:Ingredient {id:'ing-atorvastatin', name:'atorvastatin'})
